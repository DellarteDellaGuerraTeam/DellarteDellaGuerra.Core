<Brushes>
  <!-- The blue/gold pixels are in ui_quest_1. Remove only native warm hue/color
       multipliers; keep geometry, state brightness, storyline saturation and sounds.
       All four originals belong to SandBox, including NavalMainStory: no DLC dependency. -->
  <Brush Name="Quest.LeftPanel.Toggle">
    <Layers>
      <BrushLayer Name="Default" Sprite="Quest\quest_collapser_default" ExtendBottom="8" ExtendTop="3" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" ColorFactor="1.2" />
      </Style>
      <Style Name="Selected">
        <BrushLayer Name="Default" ColorFactor="1.5" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" ColorFactor="0.9" />
      </Style>
    </Styles>
    <SoundProperties>
      <StateSounds>
      </StateSounds>
      <EventSounds>
        <EventSound EventName="Click" Audio="filter" />
      </EventSounds>
    </SoundProperties>
  </Brush>
  <Brush Name="Quest.LeftPanel.QuestButton.Active">
    <Layers>
      <BrushLayer Name="Default" Sprite="Quest\quest_screen_tuple_default" ColorFactor="1.1" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" ColorFactor="1.3" />
      </Style>
      <Style Name="Selected">
        <BrushLayer Name="Default" SaturationFactor="50" ColorFactor="1.8" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" ColorFactor="0.8" />
      </Style>
    </Styles>
  </Brush>
  <Brush Name="Quest.LeftPanel.QuestButton.Active.MainStory">
    <Layers>
      <BrushLayer Name="Default" Sprite="Quest\quest_screen_tuple_default" SaturationFactor="100" ColorFactor="1.1" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" ColorFactor="1.3" />
      </Style>
      <Style Name="Selected">
        <BrushLayer Name="Default" ColorFactor="2" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" ColorFactor="0.8" />
      </Style>
    </Styles>
  </Brush>
  <Brush Name="Quest.LeftPanel.QuestButton.Active.NavalMainStory">
    <Layers>
      <BrushLayer Name="Default" Sprite="Quest\quest_screen_tuple_default" ColorFactor="1.2" SaturationFactor="60" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" ColorFactor="1.3" />
      </Style>
      <Style Name="Selected">
        <BrushLayer Name="Default" ColorFactor="2" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" ColorFactor="0.8" />
      </Style>
    </Styles>
  </Brush>
</Brushes>
