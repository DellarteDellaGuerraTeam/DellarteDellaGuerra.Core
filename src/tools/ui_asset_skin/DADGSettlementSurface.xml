<Brushes>
  <!-- Preserve every native state and change only the category colour. -->
  <Brush Name="SettlementOverlay.PartyList.Button">
    <Layers>
      <BrushLayer Name="Default" Sprite="SPGeneral\MapOverlay\Settlement\parties_characters_group_background" Color="#2870A9FF"/>
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" ColorFactor="1"/>
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" ColorFactor="1.3" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" ColorFactor="0.8" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Default" ColorFactor="0.1" />
      </Style>
      <Style Name="Selected">
        <BrushLayer Name="Default" ColorFactor="1.3" />
      </Style>
    </Styles>
  </Brush>
  <Brush Name="SettlementOverlay.CharacterList.Button">
    <Layers>
      <BrushLayer Name="Default" Sprite="SPGeneral\MapOverlay\Settlement\parties_characters_group_background" Color="#E7BC50FF"/>
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default"  ColorFactor="1"/>
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" ColorFactor="1.3" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" ColorFactor="0.8" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Default" ColorFactor="0.1" />
      </Style>
      <Style Name="Selected">
        <BrushLayer Name="Default" ColorFactor="1.3" />
      </Style>
    </Styles>
  </Brush>
</Brushes>
