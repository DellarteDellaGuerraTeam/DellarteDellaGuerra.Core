<Brushes>
  <Brush Name="FaceGen.Scrollbar.Handle">
    <Layers>
      <BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" Color="#D8AB45FF" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" ColorFactor="1" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" ColorFactor="1.2" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" ColorFactor="0.8" />
      </Style>
      <Style Name="Selected">
        <BrushLayer Name="Default" ColorFactor="1.2" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Default" AlphaFactor="0.5" />
      </Style>
    </Styles>
  </Brush>
  <Brush Name="FaceGen.Card">
    <Layers>
      <BrushLayer Name="Default" Sprite="General\CharacterCreation\facegen_card" ExtendLeft="10" ExtendRight="10" ExtendTop="10" ExtendBottom="10" />
      <BrushLayer Name="Selected" Sprite="General\CharacterCreation\facegen_card_selected" ExtendLeft="17" ExtendRight="17" ExtendTop="17" ExtendBottom="17" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" ColorFactor="1" />
        <BrushLayer Name="Selected" IsHidden="true" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" ColorFactor="1.35" />
        <BrushLayer Name="Selected" IsHidden="true" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" ColorFactor="0.8" />
        <BrushLayer Name="Selected" IsHidden="true" />
      </Style>
      <Style Name="Selected">
        <BrushLayer Name="Default" IsHidden="true" />
        <BrushLayer Name="Selected" ColorFactor="1.25" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Default" AlphaFactor="0.5" />
        <BrushLayer Name="Selected" IsHidden="true" />
      </Style>
    </Styles>
    <SoundProperties>
      <EventSounds>
        <EventSound EventName="Click" Audio="checkbox" />
      </EventSounds>
    </SoundProperties>
  </Brush>
</Brushes>
