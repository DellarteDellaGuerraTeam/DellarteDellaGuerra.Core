<Brushes>
  <Brush Name="Kingdom.Item.Tuple">
    <Layers><BrushLayer Name="Default" Sprite="SPKingdom\kingdom_tuple" Color="#FFFFFFFF" ColorFactor="1.3" /></Layers>
    <Styles>
      <Style Name="Default"><BrushLayer Name="Default" /></Style>
      <Style Name="Hovered"><BrushLayer Name="Default" ColorFactor="1.2" /></Style>
      <Style Name="Selected"><BrushLayer Name="Default" ColorFactor="1.5" Color="#FFFFFFFF" /></Style>
      <Style Name="Pressed"><BrushLayer Name="Default" ColorFactor="0.9" /></Style>
      <Style Name="Disabled"><BrushLayer Name="Default" ColorFactor="0.9" SaturationFactor="-70" /></Style>
    </Styles>
  </Brush>
  <Brush Name="Kingdom.Wars.AtWar.Tuple" BaseBrush="Kingdom.Item.Tuple">
    <Layers><BrushLayer Name="Default" Sprite="SPKingdom\Diplomacy\wars_at_war_tuple" ColorFactor="1" Color="#FFEBC1FF" /></Layers>
    <Styles><Style Name="Selected"><BrushLayer Name="Default" Color="#FFC349FF" /></Style></Styles>
  </Brush>
  <Brush Name="Kingdom.Policy.Toggle.Tuple">
    <Layers><BrushLayer Name="Default" Sprite="SPKingdom\policy_collapser_default" ExtendBottom="8" ExtendTop="3" SaturationFactor="0" HueFactor="0" /></Layers>
    <Styles>
      <Style Name="Default"><BrushLayer Name="Default" /></Style>
      <Style Name="Hovered"><BrushLayer Name="Default" ColorFactor="1.2" /></Style>
      <Style Name="Selected"><BrushLayer Name="Default" ColorFactor="1.5" Color="#FFFFFFFF" /></Style>
      <Style Name="Pressed"><BrushLayer Name="Default" ColorFactor="0.9" /></Style>
    </Styles>
  </Brush>
</Brushes>
