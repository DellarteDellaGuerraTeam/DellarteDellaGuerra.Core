<Brushes>
  <!-- Shared portrait cards keep native behavior. Party retains its translucent
       category tint; character/notable slots use an opaque DADG navy fill. -->
  <Brush Name="GameMenu.Tableau.Background.Party">
    <Layers>
      <BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" Color="#2870A922"/>
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" ColorFactor="2" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" ColorFactor="0.8" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Default" ColorFactor="0.2" />
      </Style>
      <Style Name="Selected">
        <BrushLayer Name="Default" ColorFactor="0.6" />
      </Style>
    </Styles>
  </Brush>
  <Brush Name="GameMenu.Tableau.Background.Character">
    <Layers>
      <BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" Color="#030B16FF"/>
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" ColorFactor="2" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" ColorFactor="0.8" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Default" ColorFactor="0.2" />
      </Style>
      <Style Name="Selected">
        <BrushLayer Name="Default" ColorFactor="0.6" />
      </Style>
    </Styles>
  </Brush>
</Brushes>
