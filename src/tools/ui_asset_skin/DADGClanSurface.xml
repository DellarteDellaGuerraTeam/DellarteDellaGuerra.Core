<Brushes>
  <Brush Name="Clan.Management.Collapser">
    <Layers>
      <BrushLayer Name="Default" Sprite="Clan\clan_collapser" Color="#FFFFFFFF" ExtendBottom="8" ExtendTop="3" SaturationFactor="0" HueFactor="0" />
    </Layers>
    <Styles>
      <Style Name="Default"><BrushLayer Name="Default" /></Style>
      <Style Name="Hovered"><BrushLayer Name="Default" ColorFactor="1.2" /></Style>
      <Style Name="Disabled"><BrushLayer Name="Default" ColorFactor="0.7" SaturationFactor="-50" /></Style>
      <Style Name="Selected"><BrushLayer Name="Default" ColorFactor="1.5" Color="#FFFFFFFF" /></Style>
      <Style Name="Pressed"><BrushLayer Name="Default" ColorFactor="0.9" /></Style>
    </Styles>
    <SoundProperties>
      <StateSounds />
      <EventSounds><EventSound EventName="Click" Audio="filter" /></EventSounds>
    </SoundProperties>
  </Brush>
  <Brush Name="Clan.Item.Tuple">
    <Layers><BrushLayer Name="Default" Sprite="Clan\clan_tuple" Color="#FFFFFFFF" ColorFactor="1.3" /></Layers>
    <Styles>
      <Style Name="Default"><BrushLayer Name="Default" /></Style>
      <Style Name="Hovered"><BrushLayer Name="Default" ColorFactor="1.2" /></Style>
      <Style Name="Selected"><BrushLayer Name="Default" ColorFactor="1.5" Color="#FFFFFFFF" /></Style>
      <Style Name="Pressed"><BrushLayer Name="Default" ColorFactor="0.9" /></Style>
    </Styles>
  </Brush>
</Brushes>
