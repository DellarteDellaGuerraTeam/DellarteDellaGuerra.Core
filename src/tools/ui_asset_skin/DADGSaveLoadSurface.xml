<Brushes>
  <!-- The blue/gold artwork is in ui_saveload_1. Remove only the native header's
       warm tint; keep layout, interaction brightness, and unavailable-save styles. -->
  <Brush Name="SaveLoad.Collapser">
    <Layers>
      <BrushLayer Name="Default" Sprite="SaveLoad\load_collapser" Color="#FFFFFFFF" ExtendBottom="8" ExtendTop="3" SaturationFactor="0" HueFactor="0" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" ColorFactor="1.2" />
      </Style>
      <Style Name="Selected">
        <BrushLayer Name="Default" ColorFactor="1.5" Color="#FFFFFFFF" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" ColorFactor="0.9" />
      </Style>
    </Styles>
    <SoundProperties>
      <StateSounds>
      </StateSounds>
      <EventSounds>
        <EventSound EventName="Click" Audio="filter" />
      </EventSounds>
    </SoundProperties>
  </Brush>
  <Brush Name="Saveload.Scrollbar.Handle">
    <Layers>
      <BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" Color="#E7BC50FF" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" ColorFactor="1" AlphaFactor="0.9" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" ColorFactor="1.2" AlphaFactor="1" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" ColorFactor="0.8" />
      </Style>
      <Style Name="Selected">
        <BrushLayer Name="Default" ColorFactor="1.2" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Default" AlphaFactor="0.5" />
      </Style>
    </Styles>
  </Brush>
</Brushes>
