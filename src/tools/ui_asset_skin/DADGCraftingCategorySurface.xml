<Brushes>
  <!-- Scope the shared navy/gold art to crafting. The native order-card sprites
       are also used by deployment hero cards, which are deliberately untouched. -->
  <Brush Name="Crafting.Order.Card" TransitionDuration="0.08">
    <Layers>
      <BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" Color="#071C2EFF" AlphaFactor="0.75" />
      <!-- Match FaceGen's existing gold-frame padding without moving the card. -->
      <BrushLayer Name="DADGFrame" Sprite="gold_frame_9" Color="#FFFFFFFF" ExtendLeft="5" ExtendTop="5" ExtendRight="5" ExtendBottom="6" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" ColorFactor="1.0" />
        <BrushLayer Name="DADGFrame" ColorFactor="0.85" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" ColorFactor="1.3" />
        <BrushLayer Name="DADGFrame" ColorFactor="1.15" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" ColorFactor="0.8" />
        <BrushLayer Name="DADGFrame" ColorFactor="0.8" />
      </Style>
      <Style Name="Selected">
        <BrushLayer Name="Default" Color="#103653FF" />
        <BrushLayer Name="DADGFrame" ColorFactor="1.25" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Default" ColorFactor="0.75" SaturationFactor="-100" />
        <BrushLayer Name="DADGFrame" ColorFactor="0.75" SaturationFactor="-100" AlphaFactor="0.5" />
      </Style>
    </Styles>
    <SoundProperties>
      <EventSounds>
        <EventSound EventName="Click" Audio="popup" />
        <EventSound EventName="HoverBegin" Audio="mini_popup" />
      </EventSounds>
    </SoundProperties>
  </Brush>
  <Brush Name="Crafting.Weapon.Type.Selection.Button">
    <Layers>
      <BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" Color="#071C2EFF" />
      <BrushLayer Name="DADGFrame" Sprite="gold_frame_9" Color="#FFFFFFFF" ExtendLeft="5" ExtendTop="5" ExtendRight="5" ExtendBottom="6" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" ColorFactor="1.0" />
        <BrushLayer Name="DADGFrame" ColorFactor="1" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" ColorFactor="1.2" />
        <BrushLayer Name="DADGFrame" ColorFactor="1.2" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" ColorFactor="0.8" />
        <BrushLayer Name="DADGFrame" ColorFactor="0.8" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Default" ColorFactor="0.6" SaturationFactor="-50" />
        <BrushLayer Name="DADGFrame" ColorFactor="0.6" SaturationFactor="-50" />
      </Style>
      <Style Name="Selected">
        <BrushLayer Name="Default" ColorFactor="1" />
        <BrushLayer Name="DADGFrame" ColorFactor="1.25" />
      </Style>
    </Styles>
    <SoundProperties>
      <EventSounds>
        <EventSound EventName="Click" Audio="sort" />
      </EventSounds>
    </SoundProperties>
  </Brush>
</Brushes>
