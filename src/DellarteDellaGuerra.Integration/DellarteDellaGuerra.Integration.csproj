<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>1.2.0</Version>
        <TargetFramework>netstandard2.0</TargetFramework>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <Platforms>x64</Platforms>
        <LangVersion>12.0</LangVersion>
        <Nullable>enable</Nullable>
        <BuildForWindows>true</BuildForWindows>
        <BuildForWindowsStore>true</BuildForWindowsStore>
        <ModuleId>DellarteDellaGuerra.Core</ModuleId>
        <ModuleName>Dell'Arte Della Guerra Core</ModuleName>

        <GameFolder>D:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord-v1.2</GameFolder>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Bannerlord.BuildResources" Version="1.1.0.104" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"/>
        <PackageReference Include="IsExternalInit" Version="1.0.3" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"/>
        <PackageReference Include="NLog" Version="5.3.4"/>
        <PackageReference Include="NLog.Extensions.Logging" Version="5.3.14"/>
        <PackageReference Include="Harmony.DependencyInjection" Version="0.2.0"/>

        <PackageReference Include="Bannerlord.ReferenceAssemblies.Core" Version="$(GameVersion).*-*" PrivateAssets="All"/>
        <PackageReference Include="Bannerlord.ReferenceAssemblies.Sandbox" Version="$(GameVersion).*-*" PrivateAssets="All"/>
        <PackageReference Include="Bannerlord.ReferenceAssemblies.Native" Version="$(GameVersion).*-*" PrivateAssets="All"/>

        <Reference Include="Bannerlord.Cannons">
            <HintPath>D:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord-v1.2\Modules\Bannerlord.Cannons\Bannerlord.Cannons\obj\x64\Debug\netstandard2.0\Bannerlord.Cannons.dll</HintPath>
        </Reference>

        <ProjectReference Include="..\DellarteDellaGuerra.Domain\DellarteDellaGuerra.Domain.csproj"/>
        <ProjectReference Include="..\DellarteDellaGuerra.Infrastructure\DellarteDellaGuerra.Infrastructure.csproj"/>
        <ProjectReference Include="..\DellarteDellaGuerra\DellarteDellaGuerra.csproj"/>
        <Reference Include="Bannerlord.Cannons.API">
            <HintPath>D:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord-v1.2\Modules\Bannerlord.Cannons\Bannerlord.Cannons.API\obj\Debug\netstandard2.0\Bannerlord.Cannons.API.dll</HintPath>
        </Reference>
    </ItemGroup>

    <!-- Project properties -->
    <PropertyGroup>
        <Env Condition="'$(Configuration)'=='Release'">prod</Env>
        <Env Condition="'$(Configuration)'=='Debug'">dev</Env>
    </PropertyGroup>

    <Target Name="CopyBannerlordCannonsBinariesToOutput" AfterTargets="CopyBinariesWindows"
            Condition="$(BuildForWindows) == 'true' AND $(ModuleId) != '' AND Exists($(GameFolder))">
        <ItemGroup>
            <BannerlordCannonsBinaries Include="$(MSBuildThisFileDirectory)..\..\..\..\Modules\Bannerlord.Cannons\Bannerlord.Cannons\bin\x64\$(Configuration)\netstandard2.0\*.dll"/>
            <BannerlordCannonsAPIBinary Include="$(MSBuildThisFileDirectory)..\..\..\..\Modules\Bannerlord.Cannons\Bannerlord.Cannons.API\bin\$(Configuration)\netstandard2.0\Bannerlord.Cannons.API.dll"/>
        </ItemGroup>
        <Copy SourceFiles="@(BannerlordCannonsBinaries)" DestinationFolder="$(GameFolder)/Modules/$(ModuleId)/bin/Win64_Shipping_Client" OverwriteReadOnlyFiles="true"/>
        <Copy SourceFiles="@(BannerlordCannonsAPIBinary)" DestinationFolder="$(GameFolder)/Modules/$(ModuleId)/bin/Win64_Shipping_Client" OverwriteReadOnlyFiles="true"/>
    </Target>

    <Target Name="Copy technical config files to bin folder" BeforeTargets="BeforeBuild">
        <Message Importance="high" Text="Copy config files to bin folder"/>
        <ItemGroup>
            <ConfigFolderOutput Include="$(MSBuildThisFileDirectory)..\..\config\"/>
            <LogConfigFile Include="$(MSBuildThisFileDirectory)..\technical-config\nlog.$(Env).config"/>
        </ItemGroup>
        <Copy SourceFiles="@(LogConfigFile)" DestinationFiles="$(MSBuildThisFileDirectory)..\..\config\nlog.config"/>
    </Target>

    <Target Name="Copy module binaries to wEditor" AfterTargets="CopyBinariesWindows"
            Condition="$(BuildForWindows) == 'true' AND $(ModuleId) != '' AND Exists($(GameFolder))">
        <CreateDirectory Directory="$(GameFolder)/Modules/$(ModuleId)/bin/Win64_Shipping_wEditor" />

        <CopyFolder FromDirectory="$(TargetDir)"
                    ToDirectory="$(GameFolder)/Modules/$(ModuleId)/bin/Win64_Shipping_wEditor"
                    Regex="$(PostBuildCopyToModulesRegex)"
                    Clean="true" />
    </Target>

</Project>
