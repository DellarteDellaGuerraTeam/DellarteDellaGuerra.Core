<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>1.2.0</Version>
        <TargetFramework>netstandard2.0</TargetFramework>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <Platforms>x64</Platforms>
        <LangVersion>12.0</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>DellarteDellaGuerra.Infrastructure.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="IsExternalInit" Version="1.0.3" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"/>
        <PackageReference Include="SafeFluentXPath.Implementation" Version="1.0.0" />
        <PackageReference Include="NLog" Version="5.3.4"/>

        <PackageReference Include="Bannerlord.ReferenceAssemblies.Core" Version="$(GameVersion).*-*" PrivateAssets="All"/>
        <PackageReference Include="Bannerlord.ReferenceAssemblies.Sandbox" Version="$(GameVersion).*-*" PrivateAssets="All"/>
        <PackageReference Include="Bannerlord.ReferenceAssemblies.Native" Version="$(GameVersion).*-*" PrivateAssets="All"/>

        <PackageReference Include="Harmony.DependencyInjection" Version="0.2.0"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="2.1.0"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="2.1.0"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="2.1.0"/>
        <Reference Include="Bannerlord.ExpandedTemplate.API">
            <HintPath>D:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord-v1.3\Modules\Bannerlord.ExpandedTemplate\Bannerlord.ExpandedTemplate.API\bin\Debug\netstandard2.0\Bannerlord.ExpandedTemplate.API.dll</HintPath>
            <Private>true</Private>
        </Reference>

        <Reference Include="Bannerlord.Cannons.API">
            <HintPath>D:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord-v1.3\Modules\Bannerlord.Cannons\Bannerlord.Cannons.API\bin\Debug\netstandard2.0\Bannerlord.Cannons.API.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="Bannerlord.Cannons">
            <HintPath>D:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord-v1.3\Modules\Bannerlord.Cannons\Bannerlord.Cannons.API\bin\Debug\netstandard2.0\Bannerlord.Cannons.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="Bannerlord.Cannons.Application">
            <HintPath>D:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord-v1.3\Modules\Bannerlord.Cannons\Bannerlord.Cannons.API\bin\Debug\netstandard2.0\Bannerlord.Cannons.Application.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="Bannerlord.Cannons.Domain">
            <HintPath>D:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord-v1.3\Modules\Bannerlord.Cannons\Bannerlord.Cannons.API\bin\Debug\netstandard2.0\Bannerlord.Cannons.Domain.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="Bannerlord.Cannons.Infrastructure">
            <HintPath>D:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord-v1.3\Modules\Bannerlord.Cannons\Bannerlord.Cannons.API\bin\Debug\netstandard2.0\Bannerlord.Cannons.Infrastructure.dll</HintPath>
            <Private>true</Private>
        </Reference>

        <ProjectReference Include="..\DellarteDellaGuerra.Domain\DellarteDellaGuerra.Domain.csproj" />
        <ProjectReference Include="..\DellarteDellaGuerra\DellarteDellaGuerra.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="Cannon\PartyVisualTickSettlementVisualPatch.cs" />
    </ItemGroup>


    <Target Name="Copy Win64 client files to wEditor" AfterTargets="Build">
        <Message Importance="high" Text="Copying files from Win64_Shipping_Client to Win64_Shipping_wEditor..." />
        <ItemGroup>
            <ClientFiles Include="$(MSBuildThisFileDirectory)..\..\bin\Win64_Shipping_Client\**\*" />
        </ItemGroup>
        <Copy
                SourceFiles="@(ClientFiles)"
                DestinationFolder="$(MSBuildThisFileDirectory)..\..\bin\Win64_Shipping_wEditor\%(RecursiveDir)"
                SkipUnchangedFiles="true" />
    </Target>
</Project>
