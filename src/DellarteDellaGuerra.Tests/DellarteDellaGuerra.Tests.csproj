<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <BannerlordGameRoot Condition="'$(BannerlordGameRoot)' == '' and Exists('$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.CampaignSystem.dll')">$([System.IO.Path]::GetFullPath('$(GameFolder)'))</BannerlordGameRoot>
    <BannerlordGameRoot Condition="'$(BannerlordGameRoot)' == '' and Exists('$(GameFolder)\..\bin\Win64_Shipping_Client\TaleWorlds.CampaignSystem.dll')">$([System.IO.Path]::GetFullPath('$(GameFolder)\..'))</BannerlordGameRoot>
    <BannerlordGameRoot Condition="'$(BannerlordGameRoot)' == '' and Exists('$(GameFolder)\..\..\..\bin\Win64_Shipping_Client\TaleWorlds.CampaignSystem.dll')">$([System.IO.Path]::GetFullPath('$(GameFolder)\..\..\..'))</BannerlordGameRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="TaleWorlds.CampaignSystem">
      <HintPath>$(BannerlordGameRoot)\bin\Win64_Shipping_Client\TaleWorlds.CampaignSystem.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="TaleWorlds.Core">
      <HintPath>$(BannerlordGameRoot)\bin\Win64_Shipping_Client\TaleWorlds.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="TaleWorlds.Library">
      <HintPath>$(BannerlordGameRoot)\bin\Win64_Shipping_Client\TaleWorlds.Library.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="TaleWorlds.ObjectSystem">
      <HintPath>$(BannerlordGameRoot)\bin\Win64_Shipping_Client\TaleWorlds.ObjectSystem.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DellarteDellaGuerra\DellarteDellaGuerra.csproj" />
    <ProjectReference Include="..\DellarteDellaGuerra.Domain\DellarteDellaGuerra.Domain.csproj" />
  </ItemGroup>

  <Target Name="ValidateBannerlordGameRoot" BeforeTargets="ResolveAssemblyReferences">
    <Error
      Condition="'$(BannerlordGameRoot)' == '' or !Exists('$(BannerlordGameRoot)\bin\Win64_Shipping_Client\TaleWorlds.CampaignSystem.dll')"
      Text="Could not resolve Bannerlord game root from GameFolder '$(GameFolder)'. Expected TaleWorlds.CampaignSystem.dll under bin\Win64_Shipping_Client in GameFolder or a supported parent." />
  </Target>

</Project>
