{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "mcp__bannerlord-search-1.2.12__get_bannerlord_class_definition",
      "mcp__bannerlord-search-1.2.12__search_bannerlord_code",
      "mcp__bannerlord-search-1.3.1__get_bannerlord_class_definition",
      "mcp__bannerlord-search-1.3.1__search_bannerlord_code",
      "Bash(dotnet*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'SCRIPT=\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"; if [ \"$(uname -s)\" = Linux ]; then exec \"$SCRIPT\"; elif command -v wsl.exe >/dev/null 2>&1; then wsl.exe bash \"$SCRIPT\"; fi'"
          }
        ]
      }
    ]
  }
}
